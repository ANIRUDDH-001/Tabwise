# Tabwise web — environment template (tracked; contains no secrets).
# Copy to web/.env.local (git-ignored) and fill values locally. Never commit real values.
# See docs/engineering/Tabwise-web-finish-implementation-plan.md §E.

# Supabase API endpoint (public). Inlined at build time: changes need a rebuild/redeploy.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key, sb_publishable_... (public, RLS-bound). Inlined at build time.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role key (SECRET, server-only). Bypasses RLS: never expose to the browser,
# never set on Vercel Preview without separate approval.
SUPABASE_SERVICE_ROLE_KEY=

# Set to 1 only after the GitHub OAuth provider is configured in Supabase and verified.
# Leave empty otherwise; /auth/login then shows the "sign-in unavailable" page.
TABWISE_OAUTH_CONFIGURED=

# Deliberately excluded (must stay unset; they enable live execution, dispatch or paid inference):
# MODEL_API_KEY, TABWISE_EXECUTION_APPROVAL_REF, TABWISE_META_APPROVAL_REF, GH_PAT, GH_PAT_OWNER.
