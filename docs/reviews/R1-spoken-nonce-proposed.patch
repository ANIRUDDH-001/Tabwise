+  if (!spokenTitleHasNonce(a.title_phrase, a.nonce)) fresh.push('reported title lacks this attempt\'s nonce');
+  const phrases = [a.title_phrase ?? '', ...(a.raw ?? []), ...records.flatMap((r) => (Array.isArray(r?.phrases) ? r.phrases : []))];
