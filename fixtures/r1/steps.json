{
  "spec": "PLAN.md F-02 (D-33, D-34)",
  "page": "r1/signup.html",
  "silence_ms": 1000,
  "action_timeout_ms": 8000,
  "load_timeout_ms": 15000,
  "cleanup_timeout_ms": 10000,
  "focus_retries": 10,
  "focus_delay_ms": 500,
  "nvda_settings": { "keyboard": { "speakTypedCharacters": 1, "speakTypedWords": 0 } },
  "record_settings": ["virtualBuffers.autoSayAllOnPageLoad"],
  "steps": [
    { "step": 1, "press": "Tab", "expect": { "all": ["full name"], "none": ["ada"] } },
    { "step": 2, "type": "Ada", "expect": { "typed": "ada" } },
    { "step": 3, "press": "Tab", "expect": { "all": ["email"] } },
    { "step": 4, "type": "ada@example.test", "expect": { "typed": "ada" } },
    { "step": 5, "press": "Tab", "expect": { "all": ["agree"], "state": "not-checked" } },
    { "step": 6, "press": "Space", "expect": { "state": "checked" } },
    { "step": 7, "press": "Tab", "expect": { "all": ["review"] } },
    { "step": 8, "press": "Enter", "expect": { "all": ["confirm subscription"] } },
    { "step": 9, "press": "Enter", "expect": { "all": ["subscription saved", "review"] } },
    { "step": 10, "press": "Shift+Tab", "expect": { "all": ["agree"], "state": "checked" } }
  ]
}
